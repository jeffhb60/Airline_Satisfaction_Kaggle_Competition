ce_cols]\n","        df[\"Service_Mean\"] = svc.mean(axis=1)\n","        df[\"Service_Min\"] = svc.min(axis=1)\n","        df[\"Service_Max\"] = svc.max(axis=1)\n","        df[\"Low_Rating_Count\"] = (svc <= 1).sum(axis=1).astype(np.int8)\n","        df[\"High_Rating_Count\"] = (svc >= 4).sum(axis=1).astype(np.int8)\n","\n","    online_cols = [\n","        c for c in\n","        [\"Inflight wifi service\", \"Ease of Online booking\", \"Online boarding\"]\n","        if c in df.columns\n","    ]\n","    if online_cols:\n","        df[\"Digital_Score\"] = df[online_cols].mean(axis=1)\n","\n","    comfort_cols = [\n","        c for c in\n","        [\"Seat comfort\", \"Leg room service\", \"Cleanliness\", \"Food and drink\"]\n","        if c in df.columns\n","    ]\n","    if comfort_cols:\n","        df[\"Comfort_Score\"] = df[comfort_cols].mean(axis=1)\n","\n","    if \"Flight Distance\" in df.columns:\n","        df[\"Log_Distance\"] = np.log1p(df[\"Flight Distance\"].clip(lower=0))\n","\n","    if {\"Customer Type\", \"Type of Travel\"}.issubset(df.columns):\n","        df[\"Loyal_Business\"] = (\n","            (df[\"Customer Type\"] == \"Loyal Customer\") &\n","            (df[\"Type of Travel\"] == \"Business travel\")\n","        ).astype(np.int8)\n","\n","    if {\"Type of Travel\", \"Class\"}.issubset(df.columns):\n","        df[\"Business_Business\"] = (\n","            (df[\"Type of Travel\"] == \"Business travel\") &\n","            (df[\"Class\"] == \"Business\")\n","        ).astype(np.int8)\n","\n","    return df\n","\n","\n","train = add_features(train)\n","test = add_features(test)\n","\n","print(\"Feature count after engineering:\", train.shape[1])"]},{"cell_type":"code","execution_count":6,"id":"4181f46b","metadata":{"execution":{"iopub.execute_input":"2026-10-04T00:14:04.2768Z","iopub.status.busy":"2026-10-04T00:14:04.276467Z","iopub.status.idle":"2026-10-04T00:14:04.804923Z","shell.execute_reply":"2026-10-04T00:14:04.804209Z"},"papermill":{"durati