_Mean\"] = valid.mean(axis=1)\n","    df[\"Service_Std\"] = valid.std(axis=1)\n","    df[\"Service_Min\"] = valid.min(axis=1)\n","    df[\"Service_Max\"] = valid.max(axis=1)\n","\n","    df[\"Service_NA_Count\"] = (service == 0).sum(axis=1).astype(np.int8)\n","    df[\"Low_Rating_Count\"] = (service == 1).sum(axis=1).astype(np.int8)\n","    df[\"High_Rating_Count\"] = (service >= 4).sum(axis=1).astype(np.int8)\n","\n","    return df\n","\n","\n","X = add_features(X)\n","X_test = add_features(X_test)\n","\n","print(\"Features after engineering:\", X.shape[1])"]},{"cell_type":"markdown","id":"93c87acf","metadata":{"papermill":{"duration":0.001765,"end_time":"2026-10-04T02:52:25.841953+00:00","exception":false,"start_time":"2026-10-04T02:52:25.840188+00:00","status":"completed"},"tags":[]},"source":["## 05 Prepare Categorical Columns\n","---"]},{"cell_type":"code","execution_count":6,"id":"bb246614","metadata":{"execution":{"iopub.execute_input":"2026-10-04T02:52:25.848056Z","iopub.status.busy":"2026-10-04T02:52:25.84771Z","iopub.status.idle":"2026-10-04T02:52:26.573192Z","shell.execute_reply":"2026-10-04T02:52:26.572312Z"},"papermill":{"duration":0.731111,"end_time":"2026-10-04T02:52:26.574747+00:00","exception":false,"start_time":"2026-10-04T02:52:25.843636+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Categorical columns: ['Gender', 'Customer Type', 'Type of Travel', 'Class']\n","Total features: 33\n"]}],"source":["cat_cols = [\n","    c for c in X.columns\n","    if X[c].dtype == \"object\"\n","    or str(X[c].dtype).startswith(\"category\")\n","]\n","\n","for c in cat_cols:\n","    tr = X[c].fillna(\"__MISSING__\").astype(str)\n","    te = X_test[c].fillna(\"__MISSING__\").astype(str)\n","\n","    levels = pd.Index(\n","        pd.concat([tr, te], ignore_index=True).unique()\n","    )\n","\n","    X[c] = pd.Categorical(tr, categories=levels)\n","    X_test[c] = pd.Categorical(te, categories=levels)\n","\n","pri