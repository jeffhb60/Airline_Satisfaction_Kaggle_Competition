,"oof = np.zeros(len(X), dtype=np.float32)\n","test_pred = np.zeros(len(X_test), dtype=np.float32)\n","\n","fold_scores = []\n","best_iterations = []\n","\n","for fold, (train_idx, valid_idx) in enumerate(skf.split(X, y), start=1):\n","    print(f\"\\n========== XGBoost Fold {fold}/{N_FOLDS} ==========\")\n","\n","    model = xgb.XGBClassifier(**XGB_PARAMS)\n","\n","    model.fit(\n","        X.iloc[train_idx],\n","        y[train_idx],\n","\n","        eval_set=[\n","            (X.iloc[valid_idx], y[valid_idx])\n","        ],\n","\n","        verbose=100\n","    )\n","\n","    val_pred = model.predict_proba(\n","        X.iloc[valid_idx]\n","    )[:, 1]\n","\n","    fold_test_pred = model.predict_proba(\n","        X_test\n","    )[:, 1]\n","\n","    oof[valid_idx] = val_pred.astype(np.float32)\n","    test_pred += fold_test_pred.astype(np.float32) / N_FOLDS\n","\n","    auc = roc_auc_score(y[valid_idx], val_pred)\n","\n","    fold_scores.append(auc)\n","\n","    best_iteration = getattr(model, \"best_iteration\", None)\n","    best_iterations.append(best_iteration)\n","\n","    print(f\"Fold {fold} AUC: {auc:.6f}\")\n","    print(f\"Best iteration: {best_iteration}\")\n","\n","    del model, val_pred, fold_test_pred\n","    gc.collect()\n","\n","    if torch.cuda.is_available():\n","        torch.cuda.empty_cache()\n","\n","\n","oof_auc = roc_auc_score(y, oof)\n","\n","print(\"\\n========================================\")\n","print(\"Fold AUCs:\", [round(x, 6) for x in fold_scores])\n","print(\"Mean fold AUC:\", round(float(np.mean(fold_scores)), 6))\n","print(\"XGBoost OOF AUC:\", round(float(oof_auc), 6))\n","print(\"Best iterations:\", best_iterations)\n","print(\"========================================\")"]},{"cell_type":"markdown","id":"a09b67fa","metadata":{"papermill":{"duration":0.003032,"end_time":"2026-10-04T02:52:55.284529+00:00","exception":false,"start_time":"2026-10-04T02:52:55.281497+00:00","status":"completed"},"tags":[]},"source":["## 09. Save 